# PostgreSQL
DATABASE_URL=postgresql://market_brief:change-me@localhost:5432/market_brief

# Alpaca Market Data API (never commit the real values)
ALPACA_API_KEY=replace-me
ALPACA_API_SECRET=replace-me
# SIP was verified for this project's post-close historical workflow. Use IEX only if SIP is unavailable.
ALPACA_FEED=sip

# SEC requires an identifying User-Agent, including contact information.
SEC_USER_AGENT=EquitiesDailyBrief admin@example.com

# LLM is optional: without it, the deterministic template writer is used.
# Supported values: anthropic, gemini, ollama, openai, deterministic.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Ollama is a local runtime. Start it and pull the configured model before using it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Phase 4 defaults to the custom engine; set postgres to compare query outputs.
ANALYTICS_BACKEND=engine
